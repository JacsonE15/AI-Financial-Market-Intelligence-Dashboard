# Copy this file to .env and fill in your API keys.
# Never commit the real .env file.

# Macro data (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Financial news (pick one or more)
NEWS_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# LLM for summarization / morning report generation
# Examples: DashScope (Qwen), OpenAI-compatible endpoints, Groq, etc.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# Database (SQLite by default for local Phase 1)
DATABASE_URL=sqlite:///data/market_intelligence.db

# App settings
DEFAULT_LOOKBACK_DAYS=90
LOG_LEVEL=INFO

# Set to true to skip Yahoo Finance and use deterministic demo data
FORCE_DEMO_DATA=false
